# Firebase (Auth + Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google OAuth Web Client ID (Firebase Console → Auth → Google → ID do cliente Web)
# Deve ser o cliente Web DO MESMO projeto Firebase acima — não um OAuth criado manualmente.
VITE_GOOGLE_CLIENT_ID=

# Cloudinary (upload de imagens via unsigned preset)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# O APK Android é gerado localmente via `npm run build:apk` (veja docs/ANDROID.md)
# e fica em public/downloads/app.apk. Não precisa de env var — o frontend
# detecta a presença do arquivo automaticamente via HEAD /downloads/app.apk.
